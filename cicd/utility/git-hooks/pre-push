#!/bin/sh
# Local merge gate. Before a push that updates main, run cicd.bash --gate on the
# commit being pushed, in a scratch worktree, since the working tree often has
# edits that aren't in it. Feature branches aren't gated; they're tested before
# they merge.
# SKIP_GATE=1 skips it. cicd.bash sets that for its own pushes, after a pass.
#
# Turn it on once per clone:  git config core.hooksPath cicd/utility/git-hooks

