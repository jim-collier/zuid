#!/bin/sh
# Local merge gate. Before a push that updates main, run cicd.bash --merge-gate
# on the commit being pushed, in a scratch worktree, since the working tree
# often has edits that aren't in it. A push whose commits change only the paths
# in no-gate-paths beside this skips it. dev and feature branches aren't gated.
# SKIP_GATE=1 skips it. cicd.bash sets that for its own pushes, after a pass.
#
# Turn it on once per clone:  git config core.hooksPath cicd/utility/git-hooks

##	Copyright (c) 2026 Bubbles
##	Licensed under The MIT License (MIT). Full text at:
##		https://mit-license.org/
##	SPDX-License-Identifier: MIT
set -eu

[ "${SKIP_GATE:-0}" = "1" ] && exit 0

# stdin: "<local_ref> <local_sha> <remote_ref> <remote_sha>" per ref.
mainSha=""
mainWas=""
while read -r _ localSha remoteRef remoteSha; do
	case "${remoteRef}" in
		refs/heads/main)
			# A delete pushes the zero sha, with nothing to check.
			case "${localSha}" in *[!0]*) mainSha="${localSha}"; mainWas="${remoteSha}" ;; esac
			;;
	esac
done

top="$(git rev-parse --show-toplevel)"

# The content scrub, on every push, where the private tree is here.
scrub="${top}/../private/hooks/scrub.bash"
if [ -x "${scrub}" ]; then
	"${scrub}" "${top}" || { echo "pre-push: content scrub failed" >&2; exit 1; }
fi

[ -n "${mainSha}" ] || exit 0

# Prints the first changed path no-gate-paths doesn't cover, or nothing. A new
# main, or one whose old tip isn't here, counts as changing everything.
fGatedPath() {
	case "${mainWas}" in *[!0]*) ;; *) echo "(new branch)"; return 0 ;; esac
	changed="$(git -C "${top}" diff --name-only "${mainWas}" "${mainSha}" 2>/dev/null)" \
		|| { echo "(${mainWas} isn't here)"; return 0; }
	patterns=""
	[ -f "${top}/cicd/utility/git-hooks/no-gate-paths" ] \
		&& patterns="$(grep -v -e '^#' -e '^[[:space:]]*$' "${top}/cicd/utility/git-hooks/no-gate-paths" || :)"
	printf '%s\n' "${changed}" | while IFS= read -r path; do
		[ -n "${path}" ] || continue
		covered=0
		for pattern in ${patterns}; do
			# shellcheck disable=2254  ## The pattern is meant to glob.
			case "${path}" in ${pattern}) covered=1; break ;; esac
		done
		[ "${covered}" = "1" ] || { echo "${path}"; break; }
	done
}
# The glob loop above must not expand the patterns against the filesystem.
set -f
gatedPath="$(fGatedPath)"
set +f
if [ -z "${gatedPath}" ]; then
	echo "pre-push: no gate, the push to main changes only paths in no-gate-paths" >&2
	exit 0
fi

echo "pre-push: gating the push to main with cicd.bash --merge-gate, for ${gatedPath} (SKIP_GATE=1 skips)" >&2
gateDir="$(mktemp -d "${TMPDIR:-/tmp}/zuid-gate.XXXXXX")"
tree="${gateDir}/tree"
fCleanup() {
	git -C "${top}" worktree remove --force "${tree}" >/dev/null 2>&1 || :
	rm -rf "${gateDir}"
}
trap fCleanup EXIT INT TERM
git -C "${top}" worktree add --detach -q "${tree}" "${mainSha}" \
	|| { echo "pre-push: couldn't check out ${mainSha} to gate it" >&2; exit 1; }

# zig/vendor isn't committed. Copied rather than fetched again, and the Zig
# cache is shared, so only what changed gets rebuilt.
if [ -d "${top}/zig/vendor" ]; then
	cp -R --reflink=auto "${top}/zig/vendor" "${tree}/zig/" 2>/dev/null || cp -R "${top}/zig/vendor" "${tree}/zig/"
fi
ZIG_LOCAL_CACHE_DIR="${ZIG_LOCAL_CACHE_DIR:-${top}/zig/.zig-cache}"
export ZIG_LOCAL_CACHE_DIR
"${tree}/cicd/cicd.bash" --merge-gate

##	History:
##		- 20261014: Created, from silkterm's.
##		- 20261018: --gate is --ci.
##		- 20261019: --ci is --gate again.
##		- 20261025: --merge-gate, the default run's checks. Docs-only pushes skip it.
