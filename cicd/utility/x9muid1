fNormalizeBaseName_byRef(){ _fdbgEnter "${FUNCNAME[0]}";
	local -r inVal="$1"
	local -r outVarName="$2"
	local    outVal="${inVal}"

	## Base names to numbers
	case "${outVal,,}" in
		"bin"*) outVal="2"  ;;
		"oct"*) outVal="8"  ;;
		"dec"*) outVal="10" ;;
		"hex"*) outVal="16" ;;
	esac

	## Strip "b" or "base" off
	if   [[ -n "$(echo "${outVal}"  | grep -iP "base[0-9]+.*")" ]]; then outVal="${outVal/"base"/""}"
	elif [[ -n "$(echo "${outVal}"  | grep -iP "b[0-9]+.*")"    ]]; then outVal="${outVal/"b"/""}"; fi

	## Validate
	if [[ "${outVal}" =~ 10|16|26|32|32c|32h|32r|32w|36|48j1|52|62|64|64r|64u|64j1u|64j1uw|128|128|128j1|256|256j1 ]]; then :
	else fThrowError "Unexpected base specified for '--base', '${inVal}'."  "${FUNCNAME[0]}"; fi

	## Return
	eval "${outVarName}='${outVal}'"

_fdbgEgress "${FUNCNAME[0]}"; }


