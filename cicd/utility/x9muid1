fNormalizeBool_byRef(){
	local -r inVal="$1"
	local -r outIntVarName="$2"
	local -r flagName="$3" #..... For FYI in error message
	local -i outVal=0

	case "${inVal,,}" in
		"1"|"true"|"y"|"yes")  outVal=1  ;;
		"0"|"false"|"n"|"no")  outVal=0  ;;
		*)                     fThrowError "Invalid boolean input for '${flagName}', '${inVal}'."  "${FUNCNAME[0]}" ;;
	esac

	## Return
	eval "${outIntVarName}=${outVal}"

}


