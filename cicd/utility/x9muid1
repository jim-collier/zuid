fRemoveMillenium_byref(){
	##	Purpose: Removes the millenium from a date that starts with millenium, eg 20230615 becomes 230615.

	## Args
	local     valStr="$1"
	local -r  varName="$2"  ## The variable to set with modified value.

	valStr="${valStr:1}" #.....................................: Remove first digit
	valStr="$(echo "${valStr}" | grep -iPo "[1-9][0-9]+")" #...: Remove any/all leading 0s, bash won't convert to int with leading 0s

	eval "${varName}='${valStr}'"

}


