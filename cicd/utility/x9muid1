fNormalizeInt_byRef(){ _fdbgEnter "${FUNCNAME[0]}";

	local -r  inVal="$1"
	local -r  outIntVarName="$2"
	local -ri minVal=$3
	local -ri maxVal=$4
	local -r  flagName="$5" #..... For FYI in error message
	local -i  outVal=0

	## Validate
	[[ -z "$(echo "${inVal}" | grep -iPo "[0-9]+" || true)"                          ]] && fThrowError "Invalid integer input for '${flagName}', '${inVal}'."  "${FUNCNAME[0]}"
	[[ "${inVal}" != "$(echo "${inVal}" | grep -iPo "[\-0-9]+" | head -n 1 || true)" ]] && fThrowError "Invalid integer input for '${flagName}', '${inVal}'."  "${FUNCNAME[0]}"

	outVal=$inVal

	if [[ $minVal -lt $maxVal ]]; then
		[[ $outVal -lt $minVal ]] || [[ $outVal -gt $maxVal ]] && fThrowError "Integer for '${flagName}' must be between ${minVal} and ${maxVal}. Passed: ${inVal}."  "${FUNCNAME[0]}"
	fi

	## Return
	eval "${outIntVarName}=${outVal}"

_fdbgEgress "${FUNCNAME[0]}"; }


