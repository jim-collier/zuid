fZeroPadValInBase_byref(){ _fdbgEnter "${FUNCNAME[0]}";
	##	Purpose: Pads a value with leading zeros, up to the max chars required for specified max value in specified base.

	## Args
	local -r  inputVal="$1"    ## The value which may or may not need zero-padding (already in desired base).
	local -r  maxVal="$2"      ## The maximum value that could exist in the caller's context, in base 10.
	local -ri baseInt=$3       ## The numeric base, integer-only (we don't actually care what the symbols are, except for what represents 0).
	local -r  zeroChar="$4"    ## The character that represents zero in the contextual base.
	local -r  retVarName="$5"  ## The caller's variable to populate with the result.

	## Variables
	local retVal=""
	local maxChars=""
	local -i inputCharCount=${#inputVal}
	local -i zerosToPad=0

	## Figure out the max # chars for $maxVal in $baseInt.
	## It's equal to the exponent "x" in ($baseInt^x) + someY = $inputVal, and it doesn't really matter in this context what 'someY' is because it doesn't change the x we're looking for, so we'll discard it ]
	## So then we can simplify to: $baseInt^x = $inputVal. Then solving for x:
	## log[$baseInt]($baseInt^x) = log[$baseInt] * ($inputVal)
	## x * log[$baseInt]($baseInt) = log[$baseInt]($inputVal)
	## x = log[$baseInt]($inputVal)
	## Note that bc can only compute natural logarithm (base e), so this basic math identity becomes useful:
	##	log desiredBase (x) = log base e (x) / log base e (desiredBase)
	##	Translated to bc: bc -l l(x)/l(desiredBase)
	maxChars=$(bc -l <<< "(l($maxVal)/l($baseInt))+1")  ## (log(inputval)/log(base))
	maxChars="${maxChars%.*}"  ## Truncate to integer
	[[ -z "${maxChars}" ]] && maxChars=1  ## Special case
	local -ir maxChars=$maxChars  ## Convert to read-only integer

	## Zero-pad output with base's zero character
	retVal="${inputVal}"
	zerosToPad=$((maxChars-inputCharCount))
	if ((zerosToPad > 0)); then
		for ((i=1; i<=zerosToPad ; i++)); do retVal="${zeroChar}${retVal}"; done
	fi

	eval "${retVarName}='${retVal}'"

_fdbgEgress "${FUNCNAME[0]}"; }


