#•••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••
fMain(){

	## Pre-validation
	_fMustBeInPath basename
	_fMustBeInPath x9convertbase1

	## Make template constants immutible
	local -r  meName="${meName}"

	## Token constants (these should be as weird as possible and least likely to be used either in user formatting, or any numeric base character set)
	## Depending on display font these may look the same, but are (or should be) each unique unicode characters.
	local -r token_DateTime="🟥"
	local -r token_UserName="🟧"
	local -r token_HostName="🟨"
	local -r token_FQDN="🟩"
	local -r token_MAC="🟦"
	local -r token_UUID="🟪"
	local -r token_Random="🟫"

	## Config; 1] Define placeholder variables; 2] Call fConfig() to set them; 3] Freeze them as read-only.
	local    default_outBase=""
	local    default_outFormat=""
	local -i default_dtAlgo=0
	local -i default_precision_DateTime=0
	local -i dofault_doLCaseIfAppropriate=0
	local -i default_doHash_UserName=0
	local -i default_doHash_HostName=0
	local -i default_doHash_FQDN=0
	local -i default_keepOnlyRighmostHashChars_UserName=0
	local -i default_keepOnlyRighmostHashChars_HostName=0
	local -i default_keepOnlyRighmostHashChars_FQDN=0
	local -i default_randomCharCount=0
	local -i default_doClipOut=0
	local    format_DateTime_ToSecond=""
	fConfig
	local -r  default_outBase="${default_outBase}"
	local -r  default_outFormat="${default_outFormat}"
	local -ir default_dtAlgo=$default_dtAlgo
	local -ir default_precision_DateTime=$default_precision_DateTime
	local -ir dofault_doLCaseIfAppropriate=$dofault_doLCaseIfAppropriate
	local -ir default_doHash_UserName=$default_doHash_UserName
	local -ir default_doHash_HostName=$default_doHash_HostName
	local -ir default_doHash_FQDN=$default_doHash_FQDN
	local -ir default_keepOnlyRighmostHashChars_UserName=$default_keepOnlyRighmostHashChars_UserName
	local -ir default_keepOnlyRighmostHashChars_HostName=$default_keepOnlyRighmostHashChars_HostName
	local -ir default_keepOnlyRighmostHashChars_FQDN=$default_keepOnlyRighmostHashChars_FQDN
	local -ir default_randomCharCount=$default_randomCharCount
	local -ir default_doClipOut=$default_doClipOut
	local    format_DateTime_ToSecond="${format_DateTime_ToSecond}"

	## Args; 1] Define placeholder variables; 2] Call fInit() [which then calls fValidate()] to set them; 3] Freeze them read-only.
	local -a allArgs=()
	local    outFormat=""
	local    dtOverride=""
	local    outBase=""
	local -i outBaseInt=0
	local -i dtAlgo=0
	local -i doAlgo_DateTime=0
	local -i doAlgo_UserName=0
	local -i doAlgo_HostName=0
	local -i doAlgo_FQDN=0
	local -i doAlgo_MAC=0
	local -i doAlgo_UUID=0
	local -i doAlgo_Random=0
	local -i precision_DateTime=0
	local -i randomCharCount=0
	local -i doLCaseIfAppropriate=0
	local -i doHash_UserName=0
	local -i doHash_HostName=0
	local -i doHash_FQDN=0
	local -i keepOnlyRighmostHashChars_UserName=0
	local -i keepOnlyRighmostHashChars_HostName=0
	local -i keepOnlyRighmostHashChars_FQDN=0
	local -i doClipOut=$default_doClipOut
	fInit "${@}"
	local -ra allArgs=("${allArgs[@]}")
	local -r  outFormat="${outFormat}"
	local -r  dtOverride="${dtOverride}"
	local -r  outBase="${outBase}"
	local -ir outBaseInt=$outBaseInt
	local -ir dtAlgo=$dtAlgo
	local -ir doAlgo_DateTime=$doAlgo_DateTime
	local -ir doAlgo_UserName=$doAlgo_UserName
	local -ir doAlgo_HostName=$doAlgo_HostName
	local -ir doAlgo_FQDN=$doAlgo_FQDN
	local -ir doAlgo_MAC=$doAlgo_MAC
	local -ir doAlgo_UUID=$doAlgo_UUID
	local -ir doAlgo_Random=$doAlgo_Random
	local -ir precision_DateTime=$precision_DateTime
	local -ir randomCharCount=$randomCharCount
	local -ir doLCaseIfAppropriate=$doLCaseIfAppropriate
	local -ir doHash_UserName=$doHash_UserName
	local -ir doHash_HostName=$doHash_HostName
	local -ir doHash_FQDN=$doHash_FQDN
	local -ir keepOnlyRighmostHashChars_UserName=$keepOnlyRighmostHashChars_UserName
	local -ir keepOnlyRighmostHashChars_HostName=$keepOnlyRighmostHashChars_HostName
	local -ir keepOnlyRighmostHashChars_FQDN=$keepOnlyRighmostHashChars_FQDN
	local -ir doClipOut=$doClipOut

	##Debug
	#echo -e "allArgs = '${allArgs[*]}'"
	#echo "Arg count = ${#allArgs[@]}"
	#fEchoVarAndVal dtOverride
	#fEchoVarAndVal outBase
	#fEchoVarAndVal outFormat
	#fEchoVarAndVal dtAlgo
	#fEchoVarAndVal doAlgo_DateTime
	#fEchoVarAndVal doAlgo_UserName
	#fEchoVarAndVal doAlgo_HostName
	#fEchoVarAndVal doAlgo_FQDN
	#fEchoVarAndVal doAlgo_MAC
	#fEchoVarAndVal doAlgo_UUID
	#fEchoVarAndVal doAlgo_Random
	#fEchoVarAndVal precision_DateTime
	#fEchoVarAndVal randomCharCount
	#fEchoVarAndVal doLCaseIfAppropriate
	#fEchoVarAndVal doHash_UserName
	#fEchoVarAndVal doHash_HostName
	#fEchoVarAndVal doHash_FQDN
	#fEchoVarAndVal keepOnlyRighmostHashChars_UserName
	#fEchoVarAndVal keepOnlyRighmostHashChars_HostName
	#fEchoVarAndVal keepOnlyRighmostHashChars_FQDN
	#fEchoVarAndVal doClipOut
	#fEcho
	#exit

	##
	## Make it so
	##

	local -i tmpMatchIndex=0
	local preOutputStr=""

	## Lower case?
	local extCliFlags=""
	((doLCaseIfAppropriate)) && extCliFlags="${extCliFlags} --lcase"

	## Build output string
	local outputStr="${outFormat}"

	## Username
	if ((doAlgo_UserName)); then
		preOutputStr=""
		preOutputStr="${USER}"
		[[ -z "${preOutputStr}" ]] && preOutputStr="${USERNAME}"
		if [[ -n "${preOutputStr}" ]]; then
			if ((doHash_UserName)); then
				## Cryptographic hash
				preOutputStr="$(echo "${preOutputStr}" | sha256sum | grep -iPo "[0123456789abcdef]+")"  ## existence of sha256sum is already checked in fInit().
				[[ -n "${preOutputStr}" ]] && preOutputStr="${preOutputStr^^}"
				[[ -n "${preOutputStr}" ]] && preOutputStr="$(x9convertbase1 $extCliFlags --ibase 16 ${preOutputStr} $outBase)"
				[[ -n "${preOutputStr}" ]] && [[ $keepOnlyRighmostHashChars_UserName -gt 0 ]] && [[ $keepOnlyRighmostHashChars_UserName -lt ${#preOutputStr} ]] && preOutputStr="${preOutputStr: -$keepOnlyRighmostHashChars_UserName}"
			else :;
				## Do numeric conversion if and when x9convertbase1 supports --ibase of '38username'.
				## For now just leave username unaltered.
				true
			fi
		fi
		[[ -z "${preOutputStr}" ]] && preOutputStr="USERNAME-ERROR"
		outputStr="${outputStr//"${token_UserName}"/"${preOutputStr}"}"
	fi

	## Hostname
	if ((doAlgo_HostName)); then
		_fMustBeInPath hostname
		preOutputStr=""
		preOutputStr="$(hostname --short 2>/dev/null || true)"
		if [[ -n "${preOutputStr}" ]]; then
			if ((doHash_HostName)); then
				## Cryptographic hash
				preOutputStr="$(echo "${preOutputStr}" | sha256sum | grep -iPo "[0123456789abcdef]+")"  ## existence of sha256sum is already checked in fInit().
				[[ -n "${preOutputStr}" ]] && preOutputStr="${preOutputStr^^}"
				[[ -n "${preOutputStr}" ]] && preOutputStr="$(x9convertbase1 $extCliFlags --ibase 16 ${preOutputStr} $outBase)"
				[[ -n "${preOutputStr}" ]] && [[ $keepOnlyRighmostHashChars_HostName -gt 0 ]] && [[ $keepOnlyRighmostHashChars_HostName -lt ${#preOutputStr} ]] && preOutputStr="${preOutputStr: -$keepOnlyRighmostHashChars_HostName}"
			else :;
				## Do numeric conversion if and when x9convertbase1 supports --ibase of '38hostname'.
				## For now just leave hostname unaltered.
				true
			fi
		fi
		[[ -z "${preOutputStr}" ]] && preOutputStr="HOSTNAME-ERROR"
		outputStr="${outputStr//"${token_HostName}"/"${preOutputStr}"}"
	fi

	## FQDN (Fully-Qualified host & Domain Name); for non-domain hosts, usually the same as hostname.
	if ((doAlgo_FQDN)); then
		_fMustBeInPath hostname
		preOutputStr=""
		preOutputStr="$(hostname --fqdn 2>/dev/null || true)"
		if [[ -n "${preOutputStr}" ]]; then
			if ((doHash_FQDN)); then
				## Cryptographic hash
				preOutputStr="$(echo "${preOutputStr}" | sha256sum | grep -iPo "[0123456789abcdef]+")"  ## existence of sha256sum is already checked in fInit().
				[[ -n "${preOutputStr}" ]] && preOutputStr="${preOutputStr^^}"
				[[ -n "${preOutputStr}" ]] && preOutputStr="$(x9convertbase1 $extCliFlags --ibase 16 ${preOutputStr} $outBase)"
				[[ -n "${preOutputStr}" ]] && [[ $keepOnlyRighmostHashChars_FQDN -gt 0 ]] && [[ $keepOnlyRighmostHashChars_FQDN -lt ${#preOutputStr} ]] && preOutputStr="${preOutputStr: -$keepOnlyRighmostHashChars_FQDN}"
			else :;
				## Do numeric conversion if and when x9convertbase1 supports --ibase of '38hostname'.
				## For now just leave FQDN unaltered.
				true
			fi
		fi
		[[ -z "${preOutputStr}" ]] && preOutputStr="FQDN-ERROR"
		outputStr="${outputStr//"${token_FQDN}"/"${preOutputStr}"}"
	fi

	## Primary MAC address (connected to gateway)
	if ((doAlgo_MAC)); then
		_fMustBeInPath ip
		[[ ! -d "/sys/class/net" ]] && fThrowError  "Looking in '/sys/class/net/*/address' for primary MAC address, but it doesn't seem to exist on this distro."  "${FUNCNAME[0]}"
		preOutputStr=""
		preOutputStr="$(cat "/sys/class/net/$(ip route show default | grep -iPv "dev br" | awk '/default/ {print $5}' | head -n 1)/address" 2>/dev/null || true)"
		preOutputStr="${preOutputStr//":"/""}"
		preOutputStr="${preOutputStr^^}"
		[[ -n "${preOutputStr}" ]] && preOutputStr="$(x9convertbase1 $extCliFlags --ibase 16 ${preOutputStr} $outBase)"
		[[ -z "${preOutputStr}" ]] && preOutputStr="MAC-ERROR"
		outputStr="${outputStr//"${token_MAC}"/"${preOutputStr}"}"
	fi

	## UUID (v4), "GUID" also acceptable
	if ((doAlgo_UUID)); then
		_fMustBeInPath uuid
		preOutputStr=""
		preOutputStr="$(uuid -v 4 -F SIV 2>/dev/null || true)"  ## Output UUID v4 in base 10
		[[ -n "${preOutputStr}" ]] && preOutputStr="$(x9convertbase1 $extCliFlags ${preOutputStr} $outBase)"
		[[ -z "${preOutputStr}" ]] && preOutputStr="UUID-ERROR"
		outputStr="${outputStr//"${token_UUID}"/"${preOutputStr}"}"
	fi

	## Random chars
	if ((doAlgo_Random)); then
		_fMustBeInPath od
		local -i intermediateCharCount=$((randomCharCount*2))  ## 2X is just an arbitrary multiplier to insure there's enough digits after base conversion from 16 to at least 256.
		preOutputStr=""
		preOutputStr="$(od -A n -t x -N ${intermediateCharCount} /dev/urandom 2>/dev/null || true)"
		[[ -n "${preOutputStr}" ]] && preOutputStr="${preOutputStr//[[:space:]]/""}"
		[[ -n "${preOutputStr}" ]] && preOutputStr="${preOutputStr^^}"  ## od outputs hex in lowercase, x9convertbase1 --ibase 16 expects uppercase.
		[[ -n "${preOutputStr}" ]] && preOutputStr="$(x9convertbase1 $extCliFlags --ibase 16 ${preOutputStr} $outBase 2>/dev/null || true)"
		[[ -n "${preOutputStr}" ]] && preOutputStr="${preOutputStr: -$randomCharCount}"
		[[ -z "${preOutputStr}" ]] && preOutputStr="RANDOM-ERROR"
		outputStr="${outputStr//"${token_Random}"/"${preOutputStr}"}"
	fi

	## DateTime
	if ((doAlgo_DateTime)); then

		_fMustBeInPath bc

		## Constants
		local -r fmt_dtMS_HumanReadable="+%Y%m%d%H%M%S.%3N" #....: Eg '20231231235959.999'
		local -r fmt_dtMS_Formatted="+%Y-%m-%d %H:%M:%S.%3N" #...: Eg '2023-12-31 23:59:59.999'
		local -r fmt_dtMS_Ticks="+%s.%3N" #......................: Unix ticks ('epoch'). Integer seconds since 1970, fractional milliseconds.

		## Get precise date to be used for all calcs from here. Everything you need to now about date command:
		##	date --utc --date @1695577254.931 "+%Y-%m-%d %H:%M:%S.%3N"            Ticks to formatted date
		##	date --utc --date "2023-09-21 12:44:18.932" "+%Y-%m-%d %H:%M:%S.%3N"  Convert date formatting
		##	date --utc --date "2023-09-21 12:44:18.932" "+%s.%3N"                 Convert date by string to ticks
		local dateTimeTicksMS=""
		if [[ -n "${dtOverride}" ]]; then
			## Use override date/time
			if [[ "${dtOverride}" == "$(echo "${dtOverride}" | grep -iPo "[0-9\.]+")" ]]; then
				## Override given as ticks
				dateTimeTicksMS="$(date --utc --date @"${dtOverride}" "${fmt_dtMS_Ticks}")"
			else
				## Hope that 'date' will understand the string given
				dateTimeTicksMS="$(date --utc --date "${dtOverride}" "${fmt_dtMS_Ticks}")"
			fi
		else
			## Use current UTC date/time
			dateTimeTicksMS="$(date --utc "${fmt_dtMS_Ticks}")"
		fi
		local -r dateTimeTicksMS="${dateTimeTicksMS}"

		tmpStr=""
		preOutputStr=""

		case $dtAlgo in

			## Base-converts the current UTC unix minutes, seconds, or nanoseconds since 1970-01-01 00:00:00, as appropriate according to $precision_DateTime.
			1)
				tmpStr="${dateTimeTicksMS/"."/""}"  ## Just remove the decimal point, which in this case is the same as multiplying by 1000 (to turn seconds.milliseconds into whole milliseconds).
				if   [[ $precision_DateTime -gt 0 ]]; then  tmpInt=${tmpStr} #................ Millisecond precision
				elif [[ $precision_DateTime -eq 0 ]]; then  tmpInt=$(( tmpStr /  1000 )) #.... Second precision
				else                                        tmpInt=$(( tmpStr / 60000 )) #.... Minute precision
				fi
				[[ $tmpInt -ne 0 ]] && preOutputStr="$(x9convertbase1 $extCliFlags ${tmpInt} $outBase)"
				;;

			## UTC time in YYYYMMDDHHmm[SS[NNN]] is treated as one big integer, then base-converted, as appropriate according to $precision_DateTime.
			2)
				tmpStr="$(date -d @${dateTimeTicksMS} "${fmt_dtMS_HumanReadable}")"  ## Returns date in format 'YYYYmmDDHHMMSSNNN'.
				if [[ $precision_DateTime -gt 0 ]]; then
					## Millisecond precision; already done
					:
				elif [[ $precision_DateTime -eq 0 ]]; then
					## Second precision; strip off last three digits
					tmpStr="${tmpStr:0:-3}"
				else
					## Less precision (no millenium, minute precision)
					tmpStr="${tmpStr:0:-5}"
					fRemoveMillenium_byref "${tmpStr}" tmpStr
				fi
				tmpInt=${tmpStr//"."/""}
				[[ $tmpInt -ne 0 ]] && preOutputStr="$(x9convertbase1 $extCliFlags ${tmpInt} $outBase)"
				;;

			## UTC [YYYY], [MM], [DD], [HH], [mm], [SS], and [NNN] are all treated as seperate fields and base-converted individually, as appropriate according to $precision_DateTime.
			3)
				## fDateAsFields_byref() sets preOutputStr as output from tmpStr input
				local -r zeroInBase="$(x9convertbase1 $extCliFlags 0 $outBase)"  ## This will be needed repeatedly by fDateAsFields_byref(), so save cycles by getting in only once here.
				tmpStr="$(date -d @${dateTimeTicksMS} "${fmt_dtMS_HumanReadable}")"  ## Returns date in format 'YYYYmmDDHHMMSSNNN'.
				if   [[ $precision_DateTime -gt 0 ]]; then  fDateAsFields_byref 1 1 1 1 1 1 1  ## Millisecond precision
				elif [[ $precision_DateTime -eq 0 ]]; then  fDateAsFields_byref 1 1 1 1 1 1 0  ## Second precision
				else                                        fDateAsFields_byref 1 1 1 1 1 0 0  ## Less precision (no millenium, minute precision)
				fi  ;;

			## UTC [YYYY], [MM], and [DD] are treated as seperate fields and base-converted individually.
			## ([HH][mm]), ([HH][mm][SS]), or ([HH][mm][NNN]) as a whole are divided up evenly to maximize the granularity of the entire specified numeric base, as appropriate according to $precision_DateTime.
			4)
				local -r zeroInBase="$(x9convertbase1 $extCliFlags 0 $outBase)"  ## This will be needed repeatedly by fDateAsFields_byref(), so save cycles by getting in only once here.
				local -r formattedDate="$(date -d @${dateTimeTicksMS} "${fmt_dtMS_Formatted}")"  ## Returns date in format 'YYYY-mm-DD HH:MM:SS.NNN'.
				tmpStr="$(date -d @${dateTimeTicksMS} "${fmt_dtMS_HumanReadable}")"  ## Returns date in format 'YYYYmmDDHHMMSSNNN'.

				## First, get [Y]YYYmmDD as separate fields
				fDateAsFields_byref 1 1 1 0 0 0 0 ## This function sets preOutputStr as output from tmpStr input

				## Next, calculate HHMM[SS[NNN]] to desired granularity for specified base

				## Get best hard-coded character count; per base, per precision
				local -i tmpCharCount=0
				if [[ $precision_DateTime -gt 0 ]]; then
					## Approximately millisecond precision
					case $outBaseInt in
						10)  tmpCharCount=8  ;;  ## 0.0009 seconds per tick; +14% [+015%]
						16)  tmpCharCount=7  ;;  ## 0.0003s, +068% (or tmpCharCount=6, 0.0051s, -415%)
						26)  tmpCharCount=6  ;;  ## 0.0003s, +072%
						32)  tmpCharCount=5  ;;  ## 0.0026s, -157%
						36)  tmpCharCount=5  ;;  ## 0.0014s, -043%
						48)  tmpCharCount=5  ;;  ## 0.0003s, +066%
						52)  tmpCharCount=5  ;;  ## 0.0002s, +077%
						62)  tmpCharCount=4  ;;  ## 0.0058s, -485% [-284%]
						64)  tmpCharCount=4  ;;  ## 0.0051s, -415% [-248%]
						128) tmpCharCount=4  ;;  ## 0.0003s, +139% [+068%]
						256) tmpCharCount=3  ;;  ## 0.0051s, -248% [-415%]
					esac
				elif [[ $precision_DateTime -eq 0 ]]; then
					## Approximately second precision
					case $outBaseInt in
						10)  tmpCharCount=5  ;;  ## 0.86 seconds per tick; +14%
						16)  tmpCharCount=4  ;;  ## 1.32s, -032%
						26)  tmpCharCount=3  ;;  ## 4.92s, -392% (or tmpCharCount=4, 0.19s, +81%)
						32)  tmpCharCount=3  ;;  ## 2.64s, -164%
						36)  tmpCharCount=3  ;;  ## 1.85s, -085%
						48)  tmpCharCount=3  ;;  ## 0.78s, +022%
						52)  tmpCharCount=3  ;;  ## 0.61s, +039%
						62)  tmpCharCount=3  ;;  ## 0.36s, +064%  [+120%]
						64)  tmpCharCount=3  ;;  ## 0.33s, +067%  [+135%]
						128) tmpCharCount=2  ;;  ## 5.27s, -427%  [-254%]
						256) tmpCharCount=2  ;;  ## 1.32s, -032%  [-028%]
					esac
				else
					## Approximately minute precision
					case $outBaseInt in
						10)  tmpCharCount=3  ;;  ## 86.4 seconds per tick; -44% accurate compared to 60 seconds [or -37% using more comparable average % change]
						16)  tmpCharCount=3  ;;  ## 21.1s, +065%
						26)  tmpCharCount=3  ;;  ##  4.9s, +092%
						32)  tmpCharCount=2  ;;  ## 84.4s, -041%
						36)  tmpCharCount=2  ;;  ## 66.7s, -011%
						48)  tmpCharCount=2  ;;  ## 37.5s, +038%
						52)  tmpCharCount=2  ;;  ## 31.9s, +047%
						62)  tmpCharCount=2  ;;  ## 22.5s, +063% [+0115%]
						64)  tmpCharCount=2  ;;  ## 21.1s, +065% [+0125%]
						128) tmpCharCount=2  ;;  ##  5.3s, +091% [+0564%]
						256) tmpCharCount=2  ;;  ##  1.3s, +098% [+2274%]
					esac
				fi

				## Get an accurate fraction of the UTC day elapsed so far (in base 10)
				local -r isoDate="${tmpStr:0:4}-${tmpStr:4:2}-${tmpStr:6:2}"
				local -r midnightPrev=$(date --utc --date "${isoDate}"        "${fmt_dtMS_Ticks}")
				local -r midnightNext=$(date --utc --date "${isoDate} +1 day" "${fmt_dtMS_Ticks}")
				local -r nowTicks=$(    date --utc --date "${formattedDate}"  "${fmt_dtMS_Ticks}")
				local -r percentOfDayNowUTC="$(bc -l <<< "(${nowTicks} - ${midnightPrev}) / (${midnightNext} - ${midnightPrev})")"

				## Calculate (in base 10) the possible ticks per day (=[target base]^[char count]); we want an integer, and bc without -l will give us that.
				local -i possibleBaseTicksPerDay=$(bc <<< "${outBaseInt}^${tmpCharCount}")

				## Multiply available ticks times the fraction of day elapsed so far (have to divide as last operation for bc rounding to work)
				local -i baseTicksPassed=$(bc -l <<< "scale=0; ${percentOfDayNowUTC} * ${possibleBaseTicksPerDay} / 1")

				##DEBUG
				#fEchoVarAndVal tmpStr
				#fEchoVarAndVal isoDate
				#fEchoVarAndVal fmt_dtMS_Ticks
				#fEchoVarAndVal midnightPrev
				#fEchoVarAndVal midnightNext
				#fEchoVarAndVal nowTicks
				#fEchoVarAndVal percentOfDayNowUTC
				#fEchoVarAndVal possibleBaseTicksPerDay
				#fEchoVarAndVal baseTicksPassed
				#echo

				## Convert ticks elapsed from base 10 to specified base, and append it to previous conversions
				preOutputStr="${preOutputStr}$(x9convertbase1 $extCliFlags "${baseTicksPassed}" $outBase)"

				;;

		esac
		[[ -z "${preOutputStr}" ]] && preOutputStr="DATETIME-ERROR"
		outputStr="${outputStr//"${token_DateTime}"/"${preOutputStr}"}"
	fi

	echo "${outputStr}"

	## Has to be an 'if', not an '&&' chain - a false chain would become the script's exit code.
	if ((doClipOut)) && [[ -n "$(which xclip 2>/dev/null || true)" ]]; then
		echo -n "${outputStr}" | xclip -selection clipboard || true
	fi

}


#•••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••
fInit(){

	## Constants
	local -r _allArgs="$*"

	## Variables for intermediate arg processing, with defaults
	local arg_outFormat="${default_outFormat}"
	local arg_dtOverride=""
	local arg_outBase="${default_outBase}"
	local arg_dtAlgo="${default_dtAlgo}"
	local arg_precision_DateTime="${default_precision_DateTime}"
	local arg_doHash_UserName="${default_doHash_UserName}"
	local arg_doHash_HostName="${default_doHash_HostName}"
	local arg_doHash_FQDN="${default_doHash_FQDN}"
	local arg_keepOnlyRighmostHashChars_UserName="${default_keepOnlyRighmostHashChars_UserName}"
	local arg_keepOnlyRighmostHashChars_HostName="${default_keepOnlyRighmostHashChars_HostName}"
	local arg_keepOnlyRighmostHashChars_FQDN="${default_keepOnlyRighmostHashChars_FQDN}"
	local arg_randomCharCount="${default_randomCharCount}"
	local arg_doLcase="${dofault_doLCaseIfAppropriate}"
	local arg_doClipOut="${default_doClipOut}"

	## Determine if we need to show help
	case " ${_allArgs,,} " in
		*" -h "*|*" --help "*)                 fPrint_Copyright_About_Syntax 1; exit 0 ;;
		*" -v "*|*" --ver "*|*" --version "*)  fPrint_Copyright_About_Syntax  ; exit 0 ;;
	esac

	allArgs=("$@")

	## Init for loop
	local    tmpStr=""
	local    currentArg=""
	local    lastSwitch=""
	local -i expectingSwitchParamForNextArg=0

	## Process arguments
	for currentArg in "${allArgs[@]}"; do

		## Test if an option switch or not
		if [[ ${currentArg,,} =~ ^--[^\ \-]+ ]]; then :;
			## It's an option switch

			## Check if this was supposed to NOT be a switch (eg expecting a parameter after previous switch)
			((${expectingSwitchParamForNextArg})) && fThrowError "Expecting a non-switch argument for '${lastSwitch}', instead got '${currentArg}'."  "${FUNCNAME[0]}"

			## Validate switches, and act on unary switches
			tmpStr="${currentArg,,}"  ## Lower case
			tmpStr="${tmpStr:2}"      ## Strip dashes off
			lastSwitch="${tmpStr}"    ## Remember lastSwitch
			case "${tmpStr}" in

				## Unitary switches (that take no extra params); Comment this test out if this script accepts no such thing.
				#"hash-host"*)        doHash_HostName=1  ;;
				#"hash-fqdn"*)        doHash_FQDN=1      ;;

				## Everything else, expecting a non-switch for next argument
				"format"|"fmt"|*"algo"|"base"|*"prec"*|"random-char-count"|"lc"*|*"case"|"lower"*|"clip"*|"oc"*|"hash"*|"keep-only"*|*"override")
					expectingSwitchParamForNextArg=1 ;;

				"") : ;;  ## Special case of user passing bare "--". Usually means "end of arg processing", but ignore for now.

				## ¯\_(ツ)_/¯
				*)  fThrowError  "Argument invalid or not expected in this context: '${currentArg}'."  "${FUNCNAME[0]}" ;;

			esac

		else
			## It's not an option switch; could be an option switch param, or a positional arg

			if ((expectingSwitchParamForNextArg)); then
				## Expecting option switch param

				case "${lastSwitch,,}" in
					"format"|"fmt")                        arg_outFormat="${currentArg}"                       ;;
					*"override")                           arg_dtOverride="${currentArg}"                      ;;
					"base")                                arg_outBase="${currentArg,,}"                       ;;
					*"algo")                               arg_dtAlgo=$currentArg                              ;;
					*"prec"*)                              arg_precision_DateTime=$currentArg                  ;;
					"hash-user"*)                          arg_doHash_UserName="${currentArg,,}"               ;;
					"hash-host"*)                          arg_doHash_HostName="${currentArg,,}"               ;;
					"hash-fqdn"*)                          arg_doHash_FQDN="${currentArg,,}"                   ;;
					"keep-only-righmost-hash-chars-user"*) arg_keepOnlyRighmostHashChars_UserName=$currentArg  ;;
					"keep-only-righmost-hash-chars-host"*) arg_keepOnlyRighmostHashChars_HostName=$currentArg  ;;
					"keep-only-righmost-hash-chars-fqdn")  arg_keepOnlyRighmostHashChars_FQDN=$currentArg      ;;
					"random-char-count")                   arg_randomCharCount=$currentArg                     ;;
					"lc"*|*"case"|"lower"*)                arg_doLcase="${currentArg,,}"                       ;;
					"clip"*|"oc"*)                         arg_doClipOut="${currentArg,,}"                     ;;
					*)                                     fThrowError "Unkown parameters. Switch: '--${lastSwitch}', current parameter: '${currentArg}'."  "${FUNCNAME[0]}" ;;
				esac
				expectingSwitchParamForNextArg=0

			else
				## Well it must be a positional arg then.

				fThrowError "Unexpected positional argument: '${currentArg}'."  "${FUNCNAME[0]}"

			fi

		fi
	done

	## Validate; post-loop
	((expectingSwitchParamForNextArg)) && fThrowError "Never received a parameter for switch '--${lastSwitch}'."

	## Variables not validated here
	dtOverride="${arg_dtOverride}"

	## Validate and normalize base
	fNormalizeBaseName_byRef                                                       "${arg_outBase}"                             outBase
	outBaseInt=$(echo "${outBase}" | grep -iPo "[0-9]+" | head -n 1)

	## Transform and validation
	[[ -n "${arg_dtAlgo}"                              ]] && fNormalizeInt_byRef   "${arg_dtAlgo}"                              dtAlgo                               1    4  "--dtalgo"
	[[ -n "${arg_precision_DateTime}"                  ]] && fNormalizeInt_byRef   "${arg_precision_DateTime}"                  precision_DateTime                  -1    1  "--precision"
	[[ -n "${arg_keepOnlyRighmostHashChars_UserName}"  ]] && fNormalizeInt_byRef   "${arg_keepOnlyRighmostHashChars_UserName}"  keepOnlyRighmostHashChars_UserName   0  256  "--keep-only-righmost-hash-chars-username"
	[[ -n "${arg_keepOnlyRighmostHashChars_HostName}"  ]] && fNormalizeInt_byRef   "${arg_keepOnlyRighmostHashChars_HostName}"  keepOnlyRighmostHashChars_HostName   0  256  "--keep-only-righmost-hash-chars-hostname"
	[[ -n "${arg_keepOnlyRighmostHashChars_FQDN}"      ]] && fNormalizeInt_byRef   "${arg_keepOnlyRighmostHashChars_FQDN}"      keepOnlyRighmostHashChars_FQDN       0  256  "--keep-only-righmost-hash-chars-fqdn"
	[[ -n "${arg_randomCharCount}"                     ]] && fNormalizeInt_byRef   "${arg_randomCharCount}"                     randomCharCount                      0  256  "--random-char-count"
	[[ -n "${arg_doHash_UserName}"                     ]] && fNormalizeBool_byRef  "${arg_doHash_UserName}"                     doHash_UserName                              "--hash-username"
	[[ -n "${arg_doHash_HostName}"                     ]] && fNormalizeBool_byRef  "${arg_doHash_HostName}"                     doHash_HostName                              "--hash-hostname"
	[[ -n "${arg_doHash_FQDN}"                         ]] && fNormalizeBool_byRef  "${arg_doHash_FQDN}"                         doHash_FQDN                                  "--hash-fqdn"
	[[ -n "${arg_doLcase}"                             ]] && fNormalizeBool_byRef  "${arg_doLcase}"                             doLCaseIfAppropriate                         "--lcase"
	[[ -n "${arg_doClipOut}"                           ]] && fNormalizeBool_byRef  "${arg_doClipOut}"                           doClipOut                                    "--clipout"

	## Replace user-friendly variables, with tokens that are unlikely to ever be used in either user output or numeric base, so that the same letters that will show up in bases won't screw up the search-and-replace process during fMain() processing.
	outFormat="${arg_outFormat}"
	outFormat="${outFormat//"%datetime"/"${token_DateTime}"}"
	outFormat="${outFormat//"%dt"/"${token_DateTime}"}"
	outFormat="${outFormat//"%da"/"${token_DateTime}"}"
	outFormat="${outFormat//"%d"/"${token_DateTime}"}"
	outFormat="${outFormat//"%uuid"/"${token_UUID}"}"  ## Process uuid/guid before username, so that the last thing checked can be %u for username
	outFormat="${outFormat//"%uu"/"${token_UUID}"}"
	outFormat="${outFormat//"%guid"/"${token_UUID}"}"
	outFormat="${outFormat//"%g"/"${token_UUID}"}"
	outFormat="${outFormat//"%username"/"${token_UserName}"}"
	outFormat="${outFormat//"%user"/"${token_UserName}"}"
	outFormat="${outFormat//"%usr"/"${token_UserName}"}"
	outFormat="${outFormat//"%un"/"${token_UserName}"}"
	outFormat="${outFormat//"%us"/"${token_UserName}"}"
	outFormat="${outFormat//"%u"/"${token_UserName}"}"
	outFormat="${outFormat//"%hostname"/"${token_HostName}"}"
	outFormat="${outFormat//"%host"/"${token_HostName}"}"
	outFormat="${outFormat//"%hn"/"${token_HostName}"}"
	outFormat="${outFormat//"%h"/"${token_HostName}"}"
	outFormat="${outFormat//"%fqdn"/"${token_FQDN}"}"
	outFormat="${outFormat//"%f"/"${token_FQDN}"}"
	outFormat="${outFormat//"%macaddress"/"${token_MAC}"}"
	outFormat="${outFormat//"%macaddr"/"${token_MAC}"}"
	outFormat="${outFormat//"%mac"/"${token_MAC}"}"
	outFormat="${outFormat//"%ma"/"${token_MAC}"}"
	outFormat="${outFormat//"%m"/"${token_MAC}"}"
	outFormat="${outFormat//"%random"/"${token_Random}"}"
	outFormat="${outFormat//"%rand"/"${token_Random}"}"
	outFormat="${outFormat//"%rnd"/"${token_Random}"}"
	outFormat="${outFormat//"%r"/"${token_Random}"}"

	## Determine what algos to include (these need to be checked multiple times, and we don't want to do string scanning every time that happens).
	local -i tmpMatchIndex=0
	fFindStrIndex_byref  "${outFormat}"  "${token_DateTime}"  tmpMatchIndex; [[ $tmpMatchIndex -gt 0 ]] && doAlgo_DateTime=1
	fFindStrIndex_byref  "${outFormat}"  "${token_UserName}"  tmpMatchIndex; [[ $tmpMatchIndex -gt 0 ]] && doAlgo_UserName=1
	fFindStrIndex_byref  "${outFormat}"  "${token_HostName}"  tmpMatchIndex; [[ $tmpMatchIndex -gt 0 ]] && doAlgo_HostName=1
	fFindStrIndex_byref  "${outFormat}"  "${token_FQDN}"      tmpMatchIndex; [[ $tmpMatchIndex -gt 0 ]] && doAlgo_FQDN=1
	fFindStrIndex_byref  "${outFormat}"  "${token_MAC}"       tmpMatchIndex; [[ $tmpMatchIndex -gt 0 ]] && doAlgo_MAC=1
	fFindStrIndex_byref  "${outFormat}"  "${token_UUID}"      tmpMatchIndex; [[ $tmpMatchIndex -gt 0 ]] && doAlgo_UUID=1
	fFindStrIndex_byref  "${outFormat}"  "${token_Random}"    tmpMatchIndex; [[ $tmpMatchIndex -gt 0 ]] && doAlgo_Random=1

	## At least one algo must be specified
	if [[ "${doAlgo_DateTime}${doAlgo_HostName}${doAlgo_FQDN}${doAlgo_MAC}${doAlgo_Random}${doAlgo_UUID}${doAlgo_UserName}" == "0000000" ]]; then
		fThrowError  "No algorithm was specified or allowed to by default; there's nothing to do."  "${FUNCNAME[0]}"
	fi

	## Misc validation
	((doAlgo_Random)) && [[ $randomCharCount -le 0 ]] && fThrowError  "You apparently want to include random characters, but specified '--random-char-count' of <=0."  "${FUNCNAME[0]}"
	if ((doHash_UserName)) || ((doHash_HostName)) || ((doHash_FQDN)); then _fMustBeInPath sha256sum; fi

#	## Validate lowercase flag, change a value of 'true' to 'false' if it's not valid in context.
#	## This is too much brainwork to impose on the user, so just do the work here and don't complain about a contextually 'invalid' flag value.
#	## x9convertbase1 should inherit this bit of benevolence in the future. [Done!]
#	if ((doLCaseIfAppropriate)); then
#		case ${outBase} in
#			10|32w|48j1|52|62|64|64r|64u|64j1u|64j1uw|128|128j1|256j1)
#				## Can't do lcase; either it doesn't make sense (eg base 10), or it would result in data loss for mixed-case bases, and a validation error by x9convertbase1.
#				doLCaseIfAppropriate=0
#				;;
#			16|26|32|32c|32h|32r|36)
#				## These are OK to switch to lower case, so leave set to true.
#				: ;;
#		esac
#	fi

}


#•••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••
fDateAsFields_byref(){
	##	Uses caller's variables:
	##		$tmpStr as input value
	##		$preOutputStr as output variable to set

	## Args
	local -ri doConvertYYYY=$1
	local -ri doConvertMo=$2
	local -ri doConvertDD=$3
	local -ri doConvertHH=$4
	local -ri doConvertMi=$5
	local -ri doConvertSS=$6
	local -ri doConvertNNN=$7

	## Variables
	local wrkStr=""

	## Init
	preOutputStr=""

	if ((doConvertYYYY)); then
	## Possilby remove millenium and convert [Y]YYY
		wrkStr="${tmpStr:0:4}"
		[[ $precision_DateTime -lt 0 ]] && fRemoveMillenium_byref "${wrkStr}" wrkStr
		preOutputStr="${preOutputStr}$(x9convertbase1 $extCliFlags "${wrkStr}" $outBase)"
	#	preOutputStr="${preOutputStr}Y-$(x9convertbase1 $extCliFlags "${wrkStr}" $outBase)"
	fi

	#fEchoVarAndVal preOutputStr
	#fEchoVarAndVal extCliFlags

	if ((doConvertMo)); then
		## Convert and pad month, mm
		wrkStr="${tmpStr:4:2}"
		wrkStr="$(x9convertbase1 $extCliFlags "${wrkStr}" "${outBase}")"
		fZeroPadValInBase_byref "${wrkStr}" 12 $outBaseInt "${zeroInBase}" wrkStr  ## The magic #12 is the number of months per year, the max val for mm
		preOutputStr="${preOutputStr}${wrkStr}"
	#	preOutputStr="${preOutputStr} m-${wrkStr}"
	fi

	if ((doConvertDD)); then
		## Convert and pad day, DD
		wrkStr="${tmpStr:6:2}"
		wrkStr="$(x9convertbase1 $extCliFlags "${wrkStr}" "${outBase}")"
		fZeroPadValInBase_byref "${wrkStr}" 31 $outBaseInt "${zeroInBase}" wrkStr  ## The magic #31 is the max number of days in a month, the max val for DD
		preOutputStr="${preOutputStr}${wrkStr}"
	#	preOutputStr="${preOutputStr} D-${wrkStr}"
	fi

	if ((doConvertHH)); then
		## Convert and pad 24h, HH
		wrkStr="${tmpStr:8:2}"
		wrkStr="$(x9convertbase1 $extCliFlags "${wrkStr}" "${outBase}")"
		fZeroPadValInBase_byref "${wrkStr}" 23 $outBaseInt "${zeroInBase}" wrkStr  ## The magic #23 is the max val HH can get.
		preOutputStr="${preOutputStr}${wrkStr}"
	#	preOutputStr="${preOutputStr} H-${wrkStr}"
	fi

	if ((doConvertMi)); then
		## Convert and pad minutes, MM
		wrkStr="${tmpStr:10:2}"
		wrkStr="$(x9convertbase1 $extCliFlags "${wrkStr}" "${outBase}")"
		fZeroPadValInBase_byref "${wrkStr}" 59 $outBaseInt "${zeroInBase}" wrkStr  ## The magic #59 is the max val MM can get.
		preOutputStr="${preOutputStr}${wrkStr}"
	#	preOutputStr="${preOutputStr} M-${wrkStr}"
	fi

	if ((doConvertSS)); then
		## Convert and pad seconds, SS
		wrkStr="${tmpStr:12:2}"
		wrkStr="$(x9convertbase1 $extCliFlags "${wrkStr}" "${outBase}")"
		fZeroPadValInBase_byref "${wrkStr}" 59 $outBaseInt "${zeroInBase}" wrkStr  ## The magic #59 is the max val SS can get.
		preOutputStr="${preOutputStr}${wrkStr}"
	#	preOutputStr="${preOutputStr} S-${wrkStr}"
	fi

	if ((doConvertNNN)); then
		## Convert and pad milliseconds, NNN
		wrkStr="${tmpStr:15:3}"
		wrkStr="$(x9convertbase1 $extCliFlags "${wrkStr}" "${outBase}")"
		fZeroPadValInBase_byref "${wrkStr}" 999 $outBaseInt "${zeroInBase}" wrkStr  ## The magic #999 is the max val NNN can get.
		preOutputStr="${preOutputStr}${wrkStr}"
	#	preOutputStr="${preOutputStr} N-${wrkStr}"
	fi

}


