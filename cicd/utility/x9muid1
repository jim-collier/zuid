fFindStrIndex_byref() {

	local -r mainStr="$1"
	local -r findStr="$2"
	local -r indexIntVarName="$3"
	local -i retVal=0
	local    testStr=""

	testStr="${mainStr%%"$findStr"*}"
	if [[ "${testStr}" != "${mainStr}" ]]; then
		retVal=${#testStr}
		retVal=$((retVal+1))
	fi

	## Return
	eval "${indexIntVarName}=${retVal}"

}


